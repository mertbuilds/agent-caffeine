{
  "name": "caffeinagent",
  "private": true,
  "type": "module",
  "scripts": {
    "bad-day": "bash scripts/bad-day.sh",
    "build": "turbo run build",
    "dev": "mprocs",
    "fonts": "bash scripts/fetch-fonts.sh",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --type-aware --type-check",
    "skills:check": "node scripts/skills-check.ts --strict",
    "storybook": "pnpm --filter @caffeinagent/ui storybook",
    "test": "turbo run test",
    "typecheck": "tsc -p scripts && turbo run typecheck"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^2.0.1",
    "@types/node": "^24.10.1",
    "knip": "^6.39.0",
    "mprocs": "0.9.6",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "portless": "0.15.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
