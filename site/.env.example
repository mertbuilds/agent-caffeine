# Copy to .env for local development.
# Local URLs are served by portless (https://portless.sh): named HTTPS .localhost
# domains instead of ports.

NODE_ENV=development

# Observability (off locally by default)
# AXIOM_TOKEN=
# AXIOM_DATASET=

# OpenPanel project (public, ships in the page). Counts only on caffeinagent.com,
# so a local run sends nothing even with it set.
# VITE_OPENPANEL_CLIENT_ID=

# Suisse Intl from a private R2 bucket (`pnpm fonts`), with an R2 S3 key pair
# that may only read that bucket.
# FONT_BUCKET=
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
