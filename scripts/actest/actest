#!/usr/bin/env python3
"""The guided test runner of Agent Caffeine. See actestlib/cli.py."""
import os
import sys

if sys.version_info < (3, 11):
    sys.exit("actest needs Python 3.11 or later (for tomllib). This is " + sys.version.split()[0] + ".")
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from actestlib.cli import main  # noqa: E402

sys.exit(main())
